@model PokeMyck.Models.PokemonListPagination

<h1>Pokémon</h1>

<form asp-controller="Home"
      asp-action="DescargarPokemon"
      method="post">

    @foreach (var pokemon in Model.Pokemones)
    {
        <input type="hidden"
               name="pokemones.Index"
               value="@pokemon.Name" />

        <input type="hidden"
               name="pokemones[@pokemon.Name].Name"
               value="@pokemon.Name" />

        <input type="hidden"
               name="pokemones[@pokemon.Name].ImageUrl"
               value="@pokemon.ImageUrl" />
    }

    <button type="submit">Descargar Excel</button>
</form>

<form asp-controller="Home"
      asp-action="SendByEmail"
      method="post">

    <label for="correoDestino">Correo destinatario:</label>
    <input type="email"
           id="correoDestino"
           name="correoDestino"
           required />

    @foreach (var pokemon in Model.Pokemones)
    {
        <input type="hidden"
               name="pokemones.Index"
               value="@pokemon.Name" />

        <input type="hidden"
               name="pokemones[@pokemon.Name].Name"
               value="@pokemon.Name" />

        <input type="hidden"
               name="pokemones[@pokemon.Name].ImageUrl"
               value="@pokemon.ImageUrl" />
    }

    <button type="submit">Enviar por correo</button>
</form>

@if (TempData["Error"] != null)
{
    <p style="
    color: red;
">@TempData["Error"]</p>
}

<p>
    Página @Model.PaginaActual de @Model.TotalPaginas
    — Total de Pokémon: @Model.TotalPokemones
</p>

<div>
    @foreach (var pokemon in Model.Pokemones)
    {
        <div style="display: inline-block; margin: 15px; text-align: center;">
            <img src="@pokemon.ImageUrl"
                 alt="@pokemon.Name"
                 width="120" />

            <h3>@pokemon.Name</h3>

            <a asp-controller="Home"
               asp-action="PokemonDetails"
               asp-route-nombre="@pokemon.Name">
                Ver detalles
            </a>
        </div>
    }
</div>

<nav aria-label="Paginación">
    @if (Model.PaginaActual > 1)
    {
        <a asp-action="PokemonList"
           asp-route-pagina="@(Model.PaginaActual - 1)">
            Anterior
        </a>
    }

    |

    @if (Model.PaginaActual < Model.TotalPaginas)
    {
        <a asp-action="PokemonList"
           asp-route-pagina="@(Model.PaginaActual + 1)">
            Siguiente
        </a>
    }
    <br />
    @for (int i = 1; i <= Model.TotalPaginas; i++)
    {
        if (i == Model.PaginaActual)
        {
            <span aria-current="page">@i</span>
        }
        else
        {
            if (i == 1 || i == Model.TotalPaginas || (i >= Model.PaginaActual - 5 && i <= Model.PaginaActual + 5))
            {
                <a asp-action="PokemonList"
                asp-route-pagina="@i">
                    @i
                </a>
            } else if (i == Model.PaginaActual - 5 || i == Model.PaginaActual + 5)
            {
                <span>...</span>
            }
        }
    }
</nav>